{
    "name": "jodeveloper/secure-share",
    "description": "Passcode-encrypted secret + attachment sharing for Laravel/Filament",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "illuminate/support": "^11.28 || ^12.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-medialibrary": "^11.0",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jodeveloper\\SecureShare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jodeveloper\\SecureShare\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jodeveloper\\SecureShare\\SecureShareServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
